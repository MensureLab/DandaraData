{
  "experiment": {
    "run_id": "v3_primeira_execucao",
    "description": "Baseline deterministica experimental com as duas bases historicas"
  },
  "inputs": {
    "articles": "data/raw/artigos_atual_ofc.csv",
    "fcp": "data/raw/crqrs_atual_ofc.csv",
    "historical_output": "data/reference/artigos_final_ofc_original.csv",
    "audit": "data/reference/Validacao_Auditoria.csv",
    "false_negatives": "data/reference/Falsos_Negativos.csv"
  },
  "matching": {
    "minimum_name_length": 3,
    "minimum_score": 5,
    "require_geographic_evidence": true,
    "homonym_margin": 2,
    "weights": {
      "name": 3,
      "municipality": 4,
      "state": 1,
      "context": 1,
      "cooccurrence": 2,
      "nested_only_penalty": 3
    }
  },
  "outputs": {
    "root_dir": "data/outputs"
  }
}
